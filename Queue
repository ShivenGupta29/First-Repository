#include <stdio.h>
#define SIZE 100
int front=-1;
int rear=-1;
int arr[SIZE];
void enqueue(int data)
{
    if(rear== SIZE-1)
    {
        printf("Queue is full\n");
        return;
    }
    if(front==-1&&rear==-1)
    {
        front=0;
        rear=0;
        
    }
    
    else{
        rear++;
    }
    arr[rear]=data;
}
void dequeue()
{
    if(front==-1||front>rear)
    {
        printf("Stack is empty\n");
        return;
    }
    if(front>rear)
    {
        front=-1;
        rear=-1;
        return;
    }
        int temp=arr[front];
        printf("The value poped is %d",temp);
        front++;
}
void displayarr()
{
    if (front == -1 || front > rear) {
        printf("Queue is empty\n");
        return;
    }

    printf("All the values are \n");
    for(int i=front;i<=rear;i++)
    {
        printf("%d\n",arr[i]);
    }
}
int main() {
    
    enqueue(10);
    enqueue(20);
    enqueue(30);
    enqueue(40);
    enqueue(50);
    
    displayarr();
    return 0;
}
   
