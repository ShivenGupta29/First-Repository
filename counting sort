#include <stdio.h>
void countingsort(int arr[],int n)
{
    int k=arr[0];
    int i=0;
    for(i=0;i<n;i++)
    {
        if(arr[i]>k)
        {
            k=arr[i];
        }
    }
    int c[k+1];
    int b[n];
    for(i=0;i<=k;i++)
    {
        c[i]=0;
    }
    for(i=0;i<n;i++)
    {
        c[arr[i]]++;
    }
    for(i=1;i<=k;i++)
    {
        c[i]=c[i-1]+c[i];
    }
    for(i=n-1;i>=0;i--)
    {
        b[--c[arr[i]]]=arr[i];
    }
    for(i=0;i<n;i++)
    {
        arr[i]=b[i];
    }
}
int main() 
{
    int n=0;
    printf("Enter the length of the array- ");
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    printf("The sorted array is-\n");
    countingsort(arr,n);
    for(int i=0;i<n;i++)
    {
        printf("%d  ",arr[i]);
    }
    

    return 0;
}





